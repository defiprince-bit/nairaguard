{
  "name": "@nairaguard/agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "count:independent": "tsx scripts/count-independent.ts",
    "register:erc8004": "tsx scripts/register-erc8004.ts",
    "deploy:tagged": "tsx scripts/deploy-mainnet.ts",
    "verify:deploy": "tsx scripts/verify-mainnet.ts"
  },
  "dependencies": {
    "@celo/attribution-tags": "0.5.0",
    "pg": "8.23.1",
    "viem": "2.57.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.9",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  }
}
